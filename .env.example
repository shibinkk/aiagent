# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Email (Gmail App Password) ─────────────────────────────────────────────
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_RECIPIENT=your_email@gmail.com

# ─── LinkedIn ───────────────────────────────────────────────────────────────
LINKEDIN_EMAIL=your_linkedin_email@gmail.com
LINKEDIN_PASSWORD=your_linkedin_password_here

# ─── Indeed ─────────────────────────────────────────────────────────────────
INDEED_EMAIL=your_indeed_email@gmail.com
INDEED_PASSWORD=your_indeed_password_here

# ─── Naukri ─────────────────────────────────────────────────────────────────
NAUKRI_EMAIL=your_naukri_email@gmail.com
NAUKRI_PASSWORD=your_naukri_password_here

# ─── Flask Dashboard ────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change_this_to_a_random_string
DASHBOARD_PORT=5000
